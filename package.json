{
  "name": "@mangolabs/expo-game-services",
  "version": "0.1.1",
  "description": "Game Center and Google Play Games leaderboards and achievements for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ plugin/src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "build:plugin": "node internal/module_scripts/build.js plugin",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin"
  },
  "keywords": [
    "react-native",
    "expo",
    "game-center",
    "gamekit",
    "play-games",
    "leaderboard",
    "achievements"
  ],
  "repository": "https://github.com/mangolabsbr/expo-game-services",
  "bugs": {
    "url": "https://github.com/mangolabsbr/expo-game-services/issues"
  },
  "author": "Mango Labs <cesarolimpio@gmail.com> (https://github.com/mangolabsbr)",
  "license": "MIT",
  "homepage": "https://github.com/mangolabsbr/expo-game-services#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.12",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.26",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react-native": "0.86.3",
    "typescript": "^5.9.2",
    "@types/node": "^22.14.0"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
